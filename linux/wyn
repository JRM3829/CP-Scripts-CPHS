#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WYN_HOME="${SCRIPT_DIR}"

source "${WYN_HOME}/conf/wyn.conf"
source "${WYN_HOME}/libs/core.sh"

export MODULES_DIR="${MODULES_DIR:-${WYN_HOME}/modules}"

usage() {
  printf 'usage: wyn <module> [options]\n\nmodules:\n'
  local f n
  for f in "$MODULES_DIR"/*; do
    [ -f "$f" ] && [ -x "$f" ] || continue
    n=$(basename "$f"); n="${n%.*}"
    printf '  %s\n' "$n"
  done
  printf '\nshortcut:\n  remove <pid|:port>  remove a process and its persistence\n\noptions:\n  -v, --verbose    verbose output\n  -d, --dry-run    preview destructive actions\n  -h, --help       show help\n'
  exit 0
}

ensure_wyn_on_path() {
  [ "$DRY_RUN" = true ] && return 0
  [ "$EUID" -eq 0 ] || return 0
  local f="/etc/bash.bashrc"
  grep -qF "${WYN_HOME}" "$f" 2>/dev/null && return 0
  {
    printf '\n# wyn toolkit\n'
    printf 'export PATH="%s:%s"\n' '${PATH}' "${WYN_HOME}"
  } >> "$f"
}

main() {
  [ $# -gt 0 ] || usage

  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--verbose) export VERBOSE=true; shift ;;
      -d|--dry-run) export DRY_RUN=true; shift ;;
      -h|--help) usage ;;
      *) break ;;
    esac
  done

  [ $# -gt 0 ] || usage

  [ "$EUID" -eq 0 ] || [ "$DRY_RUN" = true ] || exec sudo "$0" "$@"

  ensure_wyn_on_path

  local m="$1"; shift
  [ "$m" = remove ] && { m=processes; set -- remove "$@"; }
  local f b
  for f in "$MODULES_DIR"/*; do
    [ -f "$f" ] && [ -x "$f" ] || continue
    b=$(basename "$f")
    if [ "$b" = "$m" ] || [ "${b%.*}" = "$m" ]; then
      exec "$f" "$@"
    fi
  done
  die "unknown module: $m"
}

main "$@"
